{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/rpc/agent-event.schema.json",
  "title": "AgentEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversationId", "runId", "sequence", "type", "timestampUtc"],
  "properties": {
    "conversationId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "type": {
      "type": "string",
      "enum": ["run_started", "routing_changed", "text_delta", "run_completed", "run_cancelled", "run_failed"]
    },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "text": { "type": "string" },
    "message": { "type": "string" }
  }
}
