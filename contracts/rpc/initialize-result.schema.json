{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/rpc/initialize-result.schema.json",
  "title": "InitializeResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "sidecarVersion", "contractHash", "capabilities"],
  "properties": {
    "protocolVersion": { "type": "string" },
    "sidecarVersion": { "type": "string" },
    "contractHash": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "contains": { "const": "capability.runtime.snapshot.v2" },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
