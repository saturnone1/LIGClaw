{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/rpc/capability-invocation-context.schema.json",
  "title": "CapabilityInvocationContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotHash",
    "modelToolName",
    "capabilityId",
    "version",
    "contentHash",
    "catalogRevision",
    "connectionBindingHash"
  ],
  "properties": {
    "snapshotHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "modelToolName": {
      "type": "string",
      "pattern": "^cap_[0-9a-f]{24}$"
    },
    "capabilityId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?){1,7}$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "connectionBindingHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Opaque Desktop-owned hash of the frozen local Connection bindings."
    }
  }
}
