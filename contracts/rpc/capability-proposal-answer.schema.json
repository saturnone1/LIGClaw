{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/rpc/capability-proposal-answer.schema.json",
  "title": "CapabilityProposalAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": ["questionId", "value"],
  "properties": {
    "questionId": {
      "type": "string",
      "pattern": "^q_[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  }
}
