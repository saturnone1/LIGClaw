{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/rpc/conversation-start-params.schema.json",
  "title": "ConversationStartParams",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversationId", "runId", "input", "runtime"],
  "properties": {
    "conversationId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "input": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "enum": ["replay", "cline"] }
  }
}
