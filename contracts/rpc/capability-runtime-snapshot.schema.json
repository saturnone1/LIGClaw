{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/rpc/capability-runtime-snapshot.schema.json",
  "title": "CapabilityRuntimeSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotHash", "candidates"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "./capability-runtime-candidate.schema.json"
      }
    }
  }
}
