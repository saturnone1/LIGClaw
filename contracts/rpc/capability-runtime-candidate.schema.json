{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/rpc/capability-runtime-candidate.schema.json",
  "title": "CapabilityRuntimeCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "contentHash",
    "catalogRevision",
    "modelToolName",
    "displayName",
    "description",
    "kind",
    "intentExamples",
    "instructions",
    "canonicalInputSchemaJson",
    "requiredTools",
    "connectionBindingHash",
    "maximumRisk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?){1,7}$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "modelToolName": {
      "type": "string",
      "pattern": "^cap_[0-9a-f]{24}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "kind": {
      "type": "string",
      "enum": ["prompt", "workflow"]
    },
    "intentExamples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072
    },
    "canonicalInputSchemaJson": {
      "type": "string",
      "minLength": 2,
      "maxLength": 131072,
      "contentMediaType": "application/schema+json"
    },
    "requiredTools": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "connectionBindingHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Opaque Desktop-owned hash of the exact local Connection bindings."
    },
    "maximumRisk": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    }
  }
}
