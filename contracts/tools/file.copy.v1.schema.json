{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/file.copy.v1.schema.json",
  "title": "file.copy.v1",
  "description": "Copies up to 20 files into one existing directory without overwriting.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "destinationDirectory", "reason"],
  "properties": {
    "sources": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 3, "maxLength": 32767 } },
    "destinationDirectory": { "type": "string", "minLength": 3, "maxLength": 32767 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
