{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/file.recycle.v1.schema.json",
  "title": "file.recycle.v1",
  "description": "Moves up to 20 existing files to the Windows Recycle Bin after explicit approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["paths", "reason"],
  "properties": {
    "paths": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 3, "maxLength": 32767 } },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
