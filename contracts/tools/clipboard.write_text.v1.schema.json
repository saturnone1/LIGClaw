{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/clipboard.write_text.v1.schema.json",
  "title": "clipboard.write_text.v1",
  "description": "Writes bounded text to the clipboard after a redacted approval preview.",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "reason"],
  "properties": {
    "text": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
