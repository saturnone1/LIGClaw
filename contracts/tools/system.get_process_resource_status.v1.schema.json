{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/system.get_process_resource_status.v1.schema.json",
  "title": "system.get_process_resource_status.v1",
  "description": "Requests a bounded snapshot of process groups using the most CPU and memory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["maxResults", "reason"],
  "properties": {
    "maxResults": { "type": "integer", "minimum": 1, "maximum": 10 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
