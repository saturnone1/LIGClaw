{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/file.undo.v1.schema.json",
  "title": "file.undo.v1",
  "description": "Reverses one pending LIGClaw file operation after revalidation and explicit approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["undoId", "reason"],
  "properties": {
    "undoId": { "type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]+$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
