{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/file.zip_extract.v1.schema.json",
  "title": "file.zip_extract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["zipPath", "destinationPath", "reason"],
  "properties": {
    "zipPath": { "type": "string", "minLength": 3, "maxLength": 32767 },
