{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/web.fetch.v1.result.schema.json",
  "title": "WebFetchV1Result",
  "description": "Bounded untrusted text returned by a web endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestedUrl", "finalUrl", "statusCode", "contentType", "text", "truncated", "redirectCount"],
  "properties": {
    "requestedUrl": { "type": "string" },
    "finalUrl": { "type": "string" },
    "statusCode": { "type": "integer" },
    "contentType": { "type": "string" },
    "text": { "type": "string" },
    "truncated": { "type": "boolean" },
    "redirectCount": { "type": "integer", "minimum": 0, "maximum": 5 }
  }
}
