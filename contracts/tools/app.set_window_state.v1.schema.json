{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/app.set_window_state.v1.schema.json",
  "title": "app.set_window_state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["windowId", "state", "reason"],
  "properties": {
    "windowId": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$", "maxLength": 18 },
    "state": { "type": "string", "enum": ["minimize", "maximize", "restore"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
