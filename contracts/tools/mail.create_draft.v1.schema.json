{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/mail.create_draft.v1.schema.json",
  "title": "MailCreateDraftV1",
  "description": "Creates bounded mail draft content through a Desktop-owned Workflow executor without sending it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["to", "subject", "body"],
  "properties": {
    "to": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "format": "email", "maxLength": 254 }
    },
    "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "cc": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "format": "email", "maxLength": 254 }
    },
    "bcc": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "format": "email", "maxLength": 254 }
    }
  }
}
