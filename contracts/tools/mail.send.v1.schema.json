{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/mail.send.v1.schema.json",
  "title": "MailSendV1",
  "description": "Submits exact validated mail content through a Desktop-owned Connection binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["connectionSlot", "draftHash", "to", "cc", "bcc", "subject", "body"],
  "properties": {
    "connectionSlot": { "type": "string", "minLength": 1, "maxLength": 64 },
    "draftHash": { "type": "string", "minLength": 71, "maxLength": 71 },
    "to": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "format": "email", "maxLength": 254 }
    },
    "cc": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "format": "email", "maxLength": 254 }
    },
    "bcc": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "format": "email", "maxLength": 254 }
    },
    "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body": { "type": "string", "minLength": 1, "maxLength": 8192 }
  }
}
