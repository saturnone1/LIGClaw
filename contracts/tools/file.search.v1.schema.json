{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligclaw.local/contracts/tools/file.search.v1.schema.json",
  "title": "file.search.v1",
  "description": "Searches names below one absolute directory without reading file contents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rootPath", "pattern"],
  "properties": {
    "rootPath": { "type": "string", "minLength": 3, "maxLength": 32767 },
    "pattern": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
