<UserControl x:Class="LIGClaw.Desktop.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="예약 관리 페이지">
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SCHEDULE / LOCAL TIME" />
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="예약 관리" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="이 PC에 저장된 알림 예약을 확인하고 수정하거나 취소할 수 있습니다." />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,17,0,0" Style="{StaticResource CommandBarStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="IncludeInactive"
                      Checked="IncludeInactive_Changed" Unchecked="IncludeInactive_Changed"
                      Content="완료·취소된 예약도 표시" />
            <ComboBox x:Name="ScheduleSortBox" Grid.Column="1" MinWidth="120" Margin="12,0,0,0"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectionChanged="ScheduleSortBox_SelectionChanged"
                      AutomationProperties.Name="예약 정렬" />
            <TextBlock x:Name="PageStatusText" Grid.Column="3" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
        </Border>
        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource DataSurfaceStyle}">
            <Grid>
                <ListBox x:Name="ScheduleList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource ListRowStyle}"
                         AutomationProperties.Name="저장된 예약 목록"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0" Text="{Binding Message}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}"
                                               Text="{Binding ScheduleText}" />
                                    <Border Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Style="{StaticResource StatusTagTextStyle}" Text="{Binding StatusText}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <Button Tag="{Binding Id}" Visibility="{Binding ManageVisibility}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="Edit_Click" Content="수정" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding ManageVisibility}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="Cancel_Click" Content="삭제" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding DecisionVisibility}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="RunMissed_Click" Content="지금 실행" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding DecisionVisibility}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="SkipMissed_Click" Content="건너뛰기" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource EmptyStateTextStyle}"
                           Text="표시할 예약이 없습니다." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
