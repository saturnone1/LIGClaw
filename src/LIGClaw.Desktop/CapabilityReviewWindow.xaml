<ui:FluentWindow x:Class="LIGClaw.Desktop.CapabilityReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="기능 검토" Width="760" Height="650"
        MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Height="32" Title="기능 검토" />
        <Grid Grid.Row="1" Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="ModeEyebrow" Style="{StaticResource EyebrowTextStyle}" />
            <TextBlock x:Name="ReviewTitle" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="ReviewSubtitle" Style="{StaticResource PageSubtitleStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource DataSurfaceStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="식별자" />
                        <TextBlock x:Name="IdentityText" Grid.Column="1" Margin="18,0,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" FontWeight="SemiBold" Text="버전" />
                        <TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1" Margin="18,8,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontWeight="SemiBold" Text="검토 기준" />
                        <TextBlock x:Name="RevisionText" Grid.Row="2" Grid.Column="1" Margin="18,8,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Margin="0,8,0,0" FontWeight="SemiBold" Text="부모 버전" />
                        <TextBlock x:Name="ParentText" Grid.Row="3" Grid.Column="1" Margin="18,8,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Margin="0,8,0,0" FontWeight="SemiBold" Text="최대 위험 수준" />
                        <TextBlock x:Name="RiskText" Grid.Row="4" Grid.Column="1" Margin="18,8,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Margin="0,8,0,0" FontWeight="SemiBold" Text="필요한 작업 도구" />
                        <TextBlock x:Name="ToolsText" Grid.Row="5" Grid.Column="1" Margin="18,8,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ConnectionRequirementLabel" Grid.Row="6" Margin="0,8,0,0"
                                   FontWeight="SemiBold" Text="필요한 외부 연결" Visibility="Collapsed" />
                        <TextBlock x:Name="ConnectionsText" Grid.Row="6" Grid.Column="1" Margin="18,8,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock Grid.Row="7" Margin="0,8,0,0" FontWeight="SemiBold" Text="출처·무결성 값" />
                        <TextBlock x:Name="SourceText" Grid.Row="7" Grid.Column="1" Margin="18,8,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Border x:Name="ConnectionBindingSection" Margin="0,18,0,0"
                        Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="이 PC / 외부 연결 선택" />
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="이 PC의 연결 설정" />
                        <TextBlock Margin="0,5,0,12" Style="{StaticResource CaptionTextStyle}"
                                   Text="기능이 요구하는 연결 항목마다 이 PC에 저장된 연결 설정을 선택합니다. 서버 주소와 연결 식별자는 이 PC에만 남고 기능 파일이나 모델로 전달되지 않습니다."
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ConnectionBindingStatusText" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}"
                                       AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                            <Button x:Name="RefreshConnectionBindingsButton" Grid.Column="1" Margin="12,0,0,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    AutomationProperties.Name="기능 연결 준비 상태 다시 확인"
                                    Click="RefreshConnectionBindings_Click" Content="다시 확인" />
                        </Grid>
                        <ItemsControl x:Name="ConnectionBindingsList"
                                      AutomationProperties.Name="기능 연결 선택 목록">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Style="{StaticResource CommandBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding SlotText, Mode=OneWay}" />
                                                <ComboBox Margin="0,7,0,0" MinWidth="280"
                                                          ItemsSource="{Binding Profiles, Mode=OneWay}"
                                                          DisplayMemberPath="DisplayText"
                                                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectionChanged="ConnectionProfileSelectionChanged"
                                                          AutomationProperties.Name="{Binding SelectorAutomationName, Mode=OneWay}" />
                                                <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}"
                                                           Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom"
                                                    Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="SaveConnectionBinding_Click" Content="연결 선택 저장" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}"
                                   Text="연결 설정이나 인증정보를 변경한 뒤에는 연결 설정 화면에서 실제 연결을 다시 확인하고 연결 선택을 다시 저장해야 합니다."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,18,0,7" Style="{StaticResource SectionTitleStyle}" Text="기능 설명" />
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
                <TextBlock Margin="0,18,0,7" Style="{StaticResource SectionTitleStyle}" Text="인공지능에게 전달할 사용 지침" />
                <TextBox x:Name="InstructionsTextBox" MinHeight="150" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="기능의 인공지능 사용 지침 읽기 전용" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ReviewStatusText" Grid.Row="2" Margin="0,14,0,0"
                   Style="{StaticResource CaptionTextStyle}"
                   AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" IsDefault="True" Content="닫기" />
            <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="Collapsed" Click="Activate_Click" Content="이 버전 활성화" />
            <Button x:Name="RollbackButton" Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="Collapsed" Click="Rollback_Click" Content="이전 버전으로 되돌리기" />
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
