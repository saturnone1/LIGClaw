<Window x:Class="LIGClaw.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIGClaw" Height="650" Width="1060"
        MinHeight="500" MinWidth="760"
        Icon="Assets/ligclaw.ico"
        WindowStartupLocation="CenterScreen"
        SizeChanged="MainWindow_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarChrome" Background="{DynamicResource DeepNavyBrush}">
            <Grid x:Name="SidebarLayout" Margin="8,18,8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="{DynamicResource RadiusMedium}"
                            Background="{DynamicResource NavigationLogoBackdropBrush}">
                        <Viewbox Margin="8">
                            <Canvas Width="32" Height="32">
                                <Path Fill="{DynamicResource TextOnBrandBrush}" Data="M4,5 L19,5 L15,10 L9,10 L9,22 L15,22 L19,27 L4,27 Z" />
                                <Path Fill="{DynamicResource BrandGrayBrush}" Data="M19,5 L28,5 L23,10 L14,10 Z" />
                                <Path Fill="{DynamicResource BrandGrayBrush}" Data="M19,13 L28,13 L23,18 L14,18 Z" />
                                <Path Fill="{DynamicResource BrandGrayBrush}" Data="M19,21 L28,21 L23,27 L14,27 Z" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel x:Name="BrandCopy" Grid.Column="1" Margin="12,1,0,0">
                        <TextBlock Foreground="{DynamicResource TextOnBrandBrush}" FontSize="{DynamicResource TypeBrandSize}" FontWeight="Bold" Text="LIGClaw" />
                        <TextBlock Foreground="{DynamicResource NavigationTextMutedBrush}" Style="{StaticResource EyebrowTextStyle}"
                                   Text="PRECISION WORKSPACE" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,38,0,0">
                    <Button x:Name="HomeNavigationButton" Tag="Selected" ToolTip="대화"
                            Style="{StaticResource AppRailButtonStyle}"
                            AutomationProperties.Name="대화 홈" Click="Home_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIconStyle}" Data="M2,9 L10,2 L18,9 L18,18 L12,18 L12,12 L8,12 L8,18 L2,18 Z" />
                            <TextBlock x:Name="HomeNavigationLabel" Margin="13,0,0,0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Text="대화" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ActivityNavigationButton" Margin="0,4,0,0" ToolTip="실행 활동"
                            Style="{StaticResource AppRailButtonStyle}"
                            AutomationProperties.Name="실행 활동" Click="Activity_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIconStyle}" Data="M2,17 L2,11 L6,11 L6,17 Z M8,17 L8,6 L12,6 L12,17 Z M14,17 L14,2 L18,2 L18,17 Z" />
                            <TextBlock x:Name="ActivityNavigationLabel" Margin="13,0,0,0" VerticalAlignment="Center" Text="실행 활동" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MemoryNavigationButton" Margin="0,4,0,0" ToolTip="기억 관리"
                            Style="{StaticResource AppRailButtonStyle}"
                            AutomationProperties.Name="기억 관리" Click="Memory_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIconStyle}" Data="M4,2 L16,2 L16,18 L10,14 L4,18 Z" />
                            <TextBlock x:Name="MemoryNavigationLabel" Margin="13,0,0,0" VerticalAlignment="Center" Text="기억 관리" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScheduleNavigationButton" Margin="0,4,0,0" ToolTip="예약 관리"
                            Style="{StaticResource AppRailButtonStyle}"
                            AutomationProperties.Name="예약 관리" Click="Schedule_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIconStyle}" Data="M3,3 H17 V18 H3 Z M5,7 H15 V9 H5 Z M6,11 H9 V14 H6 Z M11,11 H14 V14 H11 Z" />
                            <TextBlock x:Name="ScheduleNavigationLabel" Margin="13,0,0,0" VerticalAlignment="Center" Text="예약 관리" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AgentJobsNavigationButton" Margin="0,4,0,0" ToolTip="Agent 작업"
                            Style="{StaticResource AppRailButtonStyle}"
                            AutomationProperties.Name="Agent 작업 관리" Click="AgentJobs_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIconStyle}" Data="M3,3 H17 V17 H3 Z M6,7 H14 M6,10 H14 M6,13 H11" />
                            <TextBlock x:Name="AgentJobsNavigationLabel" Margin="13,0,0,0" VerticalAlignment="Center" Text="Agent 작업" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavigationButton" Margin="0,4,0,0" ToolTip="설정"
                            Style="{StaticResource AppRailButtonStyle}"
                            AutomationProperties.Name="설정" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIconStyle}" Data="M8,2 H12 L13,5 L16,4 L18,8 L15,10 L18,12 L16,16 L13,15 L12,18 H8 L7,15 L4,16 L2,12 L5,10 L2,8 L4,4 L7,5 Z M8,8 H12 V12 H8 Z" />
                            <TextBlock x:Name="SettingsNavigationLabel" Margin="13,0,0,0" VerticalAlignment="Center" Text="설정" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="SidebarFooter" Grid.Row="3" Margin="7,0">
                    <Border Padding="12" CornerRadius="{DynamicResource RadiusMedium}"
                            Background="{DynamicResource NavigationLogoBackdropBrush}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SignalCyanBrush}" Style="{StaticResource EyebrowTextStyle}" Text="LOCAL" />
                            <TextBlock x:Name="SidebarFooterLabel" Margin="0,5,0,0"
                                       Foreground="{DynamicResource NavigationTextBrush}" FontSize="{DynamicResource TypeCaptionSize}"
                                       Text="데이터와 실행 권한은 이 PC에서 보호됩니다." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CommandHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ASSIST / CURRENT THREAD" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource CardTitleStyle}" Text="Windows 작업 공간" />
                    </StackPanel>

                    <Button x:Name="ConversationSwitcherButton" Grid.Column="1" Margin="12,0,0,0"
                            Style="{StaticResource CompactButtonStyle}"
                            AutomationProperties.Name="최근 대화 열기"
                            Click="ConversationSwitcher_Click" Content="대화 전환" />
                    <Popup x:Name="ConversationSwitcherPopup" PlacementTarget="{Binding ElementName=ConversationSwitcherButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Width="370" MaxHeight="450" Margin="0,8,0,0" Style="{StaticResource ElevatedCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CONVERSATIONS" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionTitleStyle}" Text="최근 대화" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ConversationSearchBox" Height="38" VerticalContentAlignment="Center"
                                             ToolTip="사용자 요청과 LIGClaw 답변을 검색합니다."
                                             AutomationProperties.Name="대화 내용 검색"
                                             TextChanged="ConversationSearchBox_TextChanged" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource CompactButtonStyle}"
                                            AutomationProperties.Name="대화 검색 지우기"
                                            Click="ClearConversationSearch_Click" Content="지우기" />
                                </Grid>
                                <ListBox x:Name="RecentConversationsList" Grid.Row="2" Margin="0,10,0,0"
                                         MinHeight="120" MaxHeight="300" BorderThickness="0"
                                         Background="Transparent" AutomationProperties.Name="최근 대화 목록"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="RecentConversationsList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRowStyle}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource InfoSubtleBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding TurnCountDisplay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="ConversationSearchStatus" Grid.Row="3" Margin="0,8,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="최근 대화를 불러오는 중입니다." />
                            </Grid>
                        </Border>
                    </Popup>

                    <Border Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeaderStatusIndicator" Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{DynamicResource WarningBrush}" />
                            <TextBlock x:Name="HeaderStatusText" Style="{StaticResource FieldLabelStyle}" Text="준비 중" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource CompactButtonStyle}"
                            AutomationProperties.Name="문제 해결 정보 열기"
                            Click="OpenDiagnostics_Click" Content="문제 해결" />
                    <Button x:Name="NewConversationButton" Grid.Column="4" Margin="10,0,0,0"
                            AutomationProperties.Name="새 대화 시작"
                            Click="NewConversation_Click" Content="새 대화" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
        <Grid x:Name="ConversationPage" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel MaxWidth="{DynamicResource ConversationReadingWidth}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ASSIST" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource PageTitleStyle}"
                           FontSize="{DynamicResource TypeDisplaySize}" Text="무엇을 도와드릴까요?" />
                <TextBlock x:Name="ConversationSubtitle" Style="{StaticResource PageSubtitleStyle}"
                           Text="새 대화를 시작하거나 최근 대화를 선택해 이어갈 수 있습니다." />
            </StackPanel>

            <Border x:Name="ComposerHost" Grid.Row="2" MaxWidth="{DynamicResource ConversationReadingWidth}"
                    Margin="0,16,0,0" Style="{StaticResource CommandSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ConnectionBanner" Style="{StaticResource WarningBannerStyle}"
                            Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ConnectionBannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button x:Name="ConnectionBannerActionButton" Grid.Column="1" Margin="14,0,0,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="ConnectionBannerAction_Click" Content="확인" />
                        </Grid>
                    </Border>
                    <WrapPanel x:Name="ComposerExamples" Grid.Row="1" Margin="0,12,0,0">
                        <Button Margin="0,0,7,7" Style="{StaticResource CompactButtonStyle}"
                                Tag="내 시스템 리소스 상태를 확인해 줘"
                                AutomationProperties.Name="예시 명령: 시스템 상태 확인"
                                Click="ExamplePrompt_Click" Content="시스템 상태 확인" />
                        <Button Margin="0,0,7,7" Style="{StaticResource CompactButtonStyle}"
                                Tag="계산기를 실행해 줘"
                                AutomationProperties.Name="예시 명령: 계산기 실행"
                                Click="ExamplePrompt_Click" Content="계산기 실행" />
                        <Button Margin="0,0,7,7" Style="{StaticResource CompactButtonStyle}"
                                Tag="2분 뒤에 테스트 알림을 보여줘"
                                AutomationProperties.Name="예시 명령: 2분 뒤 알림"
                                Click="ExamplePrompt_Click" Content="2분 뒤 알림" />
                    </WrapPanel>
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <TextBox x:Name="ConversationInput" MinHeight="74" FontSize="{DynamicResource TypeCommandSize}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxLength="20000"
                                 AutomationProperties.Name="요청 내용"
                                 AutomationProperties.HelpText="원하는 일을 평소 말하듯 입력하세요. Ctrl과 Enter를 함께 누르면 보냅니다."
                                 TextChanged="ConversationInput_TextChanged"
                                 PreviewKeyDown="ConversationInput_PreviewKeyDown" />
                        <TextBlock x:Name="InputPlaceholder" Margin="13,11" VerticalAlignment="Top"
                                   Foreground="{DynamicResource InactiveBrush}" IsHitTestVisible="False"
                                   Text="예: 오늘 해야 할 일을 정리해 줘" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RunStatus" Foreground="{DynamicResource TextSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" Text="준비하고 있어요…" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource InactiveBrush}" FontSize="{DynamicResource TypeCaptionSize}"
                                       Text="Ctrl + Enter로 보낼 수 있어요" />
                        </StackPanel>
                        <Button x:Name="ScreenContextButton" Grid.Column="1" Margin="0,0,9,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="화면 내용 가져오기"
                                AutomationProperties.HelpText="Windows에서 창이나 화면을 선택하고, 인식된 글자를 확인한 뒤 요청에 추가합니다."
                                Click="ScreenContext_Click" Content="화면 가져오기" />
                        <Button x:Name="CancelButton" Grid.Column="2" Margin="0,0,9,0"
                                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                                Click="Cancel_Click" Content="중단" />
                        <Button x:Name="SendButton" Grid.Column="3" IsEnabled="False"
                                AutomationProperties.HelpText="입력한 요청을 LIGClaw에 보냅니다."
                                Click="Send_Click" Content="보내기" />
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ConversationSurface" Grid.Row="1" MaxWidth="{DynamicResource ConversationReadingWidth}"
                  Margin="0,20,0,0" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CONVERSATION" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Text="로컬 대화 기록" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="UserMessageBubble" HorizontalAlignment="Right" MaxWidth="520"
                                    Padding="14,10" CornerRadius="{DynamicResource RadiusMedium}"
                                    Background="{DynamicResource ConversationUserBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="나" />
                                    <TextBlock x:Name="UserMessageText" Margin="0,4,0,0" TextWrapping="Wrap"
                                               AutomationProperties.Name="사용자 요청" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="TimelineProgressCard" Grid.Row="1" Margin="0,10,0,0"
                                    Style="{StaticResource ActionCardStyle}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" Margin="0,0,11,0" CornerRadius="{DynamicResource RadiusSmall}"
                                            Background="{DynamicResource InfoBrush}">
                                        <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TextOnBrandBrush}"
                                              Data="M2,9 L7,14 L16,4 L18,6 L7,17 L0,11 Z" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ACTION / IN PROGRESS" />
                                        <TextBlock x:Name="TimelineProgressText" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource EyebrowTextStyle}" Text="LIGCLAW RESPONSE" />
                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                <RichTextBox x:Name="Transcript" IsReadOnly="True" IsDocumentEnabled="True"
                                             Padding="10,8" BorderThickness="1"
                                             Background="{DynamicResource SurfaceBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             AutomationProperties.Name="LIGClaw의 답변"
                                             AutomationProperties.HelpText="텍스트와 링크 주소를 선택한 뒤 Ctrl+C로 복사할 수 있습니다."
                                             AutomationProperties.LiveSetting="Polite"
                                             ScrollViewer.ScrollChanged="Transcript_ScrollChanged"
                                             VerticalScrollBarVisibility="Auto" />
                                <Border x:Name="TranscriptPlaceholder" Margin="1" Background="{DynamicResource SurfaceBrush}">
                                    <Grid Margin="12,7">
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                                                   Text="응답을 준비하고 있습니다." />
                                        <Canvas Width="54" Height="38" HorizontalAlignment="Right" Opacity="0.18">
                                            <Path Fill="{DynamicResource BrandBlueBrush}" Data="M2,2 L52,2 L44,10 L2,10 Z" />
                                            <Path Fill="{DynamicResource SignalCyanBrush}" Data="M10,15 L54,15 L46,23 L2,23 Z" />
                                            <Path Fill="{DynamicResource BrandGrayBrush}" Data="M18,28 L50,28 L42,36 L10,36 Z" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <Button x:Name="NewContentIndicator" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,14,12" Style="{StaticResource CompactButtonStyle}"
                                        Visibility="Collapsed" Click="NewContentIndicator_Click"
                                        Content="새 응답 ↓" AutomationProperties.Name="새 응답으로 이동" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>

            <Border x:Name="SupportStatusCard" Grid.Row="3" MaxWidth="{DynamicResource ConversationReadingWidth}"
                    Margin="0,12,0,0" Visibility="Collapsed"
                    Padding="14,10" CornerRadius="{DynamicResource RadiusMedium}"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Margin="0,0,9,0"
                             Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusTitle" Grid.Column="1" FontWeight="SemiBold"
                               VerticalAlignment="Center" Text="준비 중이에요" />
                    <TextBlock x:Name="StatusMessage" Grid.Column="2" Margin="10,0,14,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Text="잠시만 기다려 주세요." />
                    <Button x:Name="RestartButton" Grid.Column="3" Margin="0,0,9,0"
                            Style="{StaticResource CompactButtonStyle}"
                            Visibility="Collapsed" Click="RestartSidecar_Click" Content="다시 연결" />
                    <Button Grid.Column="4" Style="{StaticResource CompactButtonStyle}"
                            AutomationProperties.Name="문제 해결 정보 열기"
                            Click="OpenDiagnostics_Click" Content="문제 해결 정보" />
                </Grid>
            </Border>
        </Grid>
        <ContentControl x:Name="ShellPageHost" Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Grid>
    </Grid>
</Window>
