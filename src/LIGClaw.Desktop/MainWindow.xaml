<Window x:Class="LIGClaw.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIGClaw" Height="520" Width="760"
        MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="30" FontWeight="SemiBold" Text="LIGClaw" />

        <Border Grid.Row="1" Margin="0,22,0,0" Padding="16" CornerRadius="10"
                BorderBrush="#FFD8DEE9" BorderThickness="1" Background="#FFF7F9FC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="#FF94A3B8"
                         VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" Text="Starting" />
                    <TextBlock x:Name="StatusMessage" Margin="0,3,0,0" Foreground="#FF52606D"
                               Text="Preparing the local agent runtime…" />
                </StackPanel>
                <Button Grid.Column="2" Padding="14,7" Click="RestartSidecar_Click"
                        Content="Restart runtime" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,18,0,0" Padding="14" CornerRadius="8" Background="#FFF1F5F9">
            <TextBlock Foreground="#FF334155" TextWrapping="Wrap"
                       Text="Phase 0 walking skeleton: Desktop owns the process lifecycle and verifies a versioned JSON-RPC handshake over a per-session Windows Named Pipe." />
        </Border>

        <GroupBox Grid.Row="3" Margin="0,18,0,0" Header="Diagnostics">
            <ListBox x:Name="DiagnosticsList" Margin="8" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" />
        </GroupBox>
    </Grid>
</Window>
