<Window x:Class="LIGClaw.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIGClaw" Height="660" Width="1060"
        MinHeight="620" MinWidth="900"
        Icon="Assets/ligclaw.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource BrandBlueBrush}">
            <Grid Margin="22,28,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="#1AFFFFFF">
                        <Viewbox Margin="8">
                            <Canvas Width="32" Height="32">
                                <Path Fill="White" Data="M4,5 L19,5 L15,10 L9,10 L9,22 L15,22 L19,27 L4,27 Z" />
                                <Path Fill="#D0D3D4" Data="M19,5 L28,5 L23,10 L14,10 Z" />
                                <Path Fill="#D0D3D4" Data="M19,13 L28,13 L23,18 L14,18 Z" />
                                <Path Fill="#D0D3D4" Data="M19,21 L28,21 L23,27 L14,27 Z" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="12,1,0,0">
                        <TextBlock Foreground="White" FontSize="20" FontWeight="Bold" Text="LIGClaw" />
                        <TextBlock Foreground="#BFD0E5" FontSize="11" Text="나의 Windows 도우미" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,42,0,0" Padding="13,11" CornerRadius="8" Background="#22FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,11,0" Fill="White" />
                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="홈" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3">
                    <Border Padding="13" CornerRadius="10" Background="#17FFFFFF">
                        <StackPanel>
                            <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold" Text="창을 닫아도 괜찮아요" />
                            <TextBlock Margin="0,6,0,0" Foreground="#BFD0E5" FontSize="11"
                                       Text="LIGClaw는 트레이에서 계속 기다립니다."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="2,13,0,0" Foreground="#9DB7D3" FontSize="11"
                               Text="데이터와 실행 권한은 이 PC에서 관리됩니다."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,27,32,29">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="무엇을 도와드릴까요?" />
                    <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="원하는 일을 평소 말하듯 입력해 주세요." />
                </StackPanel>
                <Border Grid.Column="1" Padding="13,9" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderStatusIndicator" Width="8" Height="8"
                                 Margin="0,0,8,0" Fill="{DynamicResource WarningBrush}" />
                        <TextBlock x:Name="HeaderStatusText" FontSize="12" FontWeight="SemiBold" Text="준비 중" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="0,23,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBox x:Name="ConversationInput" MinHeight="74" FontSize="15"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 AutomationProperties.Name="요청 내용"
                                 AutomationProperties.HelpText="원하는 일을 평소 말하듯 입력하세요. Ctrl과 Enter를 함께 누르면 보냅니다."
                                 TextChanged="ConversationInput_TextChanged"
                                 PreviewKeyDown="ConversationInput_PreviewKeyDown" />
                        <TextBlock x:Name="InputPlaceholder" Margin="13,11" VerticalAlignment="Top"
                                   Foreground="{DynamicResource InactiveBrush}" IsHitTestVisible="False"
                                   Text="예: 오늘 해야 할 일을 정리해 줘" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RunStatus" Foreground="{DynamicResource TextSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" Text="준비하고 있어요…" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource InactiveBrush}" FontSize="11"
                                       Text="Ctrl + Enter로 보낼 수 있어요" />
                        </StackPanel>
                        <Button x:Name="CancelButton" Grid.Column="1" Margin="0,0,9,0"
                                Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                                Click="Cancel_Click" Content="중단" />
                        <Button x:Name="SendButton" Grid.Column="2" IsEnabled="False"
                                AutomationProperties.HelpText="입력한 요청을 LIGClaw에 보냅니다."
                                Click="Send_Click" Content="보내기" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,19,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="17" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="답변" />
                            <TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold" Text="LIGClaw의 답변" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <TextBox x:Name="Transcript" IsReadOnly="True" TextWrapping="Wrap"
                                     AutomationProperties.Name="LIGClaw의 답변"
                                     AutomationProperties.LiveSetting="Polite"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock x:Name="TranscriptPlaceholder" Margin="13,11"
                                       Foreground="{DynamicResource InactiveBrush}" IsHitTestVisible="False"
                                       Text="요청을 보내면 답변이 여기에 표시됩니다."
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="도우미 상태" />
                                <TextBlock x:Name="StatusTitle" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"
                                           Text="준비 중이에요" />
                            </StackPanel>
                            <Ellipse x:Name="StatusIndicator" Grid.Column="1" Width="10" Height="10"
                                     Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="StatusMessage" Grid.Row="1" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="잠시만 기다려 주세요." />
                        <Button x:Name="RestartButton" Grid.Row="2" Margin="0,15,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="Collapsed" Click="RestartSidecar_Click" Content="다시 연결" />
                        <Expander Grid.Row="3" Margin="0,14,0,0" VerticalAlignment="Bottom"
                                  Header="문제 해결 정보" Foreground="{DynamicResource TextSecondaryBrush}">
                            <ListBox x:Name="DiagnosticsList" Margin="0,9,0,0" MaxHeight="92"
                                     Padding="0" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" />
                        </Expander>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
