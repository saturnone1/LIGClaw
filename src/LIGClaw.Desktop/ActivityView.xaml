<UserControl x:Class="LIGClaw.Desktop.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="실행 활동 페이지">
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ACTIVITY / LOCAL AUDIT" />
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="실행 활동" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="승인 여부와 Windows 작업 결과를 이 PC에서만 보관합니다." />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource CommandBarStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ActivityFilterBox" MinWidth="130"
                      DisplayMemberPath="Label" SelectedValuePath="Status"
                      AutomationProperties.Name="실행 상태 필터"
                      SelectionChanged="ActivityFilterBox_SelectionChanged" />
            <ComboBox x:Name="ActivitySortBox" Grid.Column="1" MinWidth="120" Margin="8,0,0,0"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      AutomationProperties.Name="실행 활동 정렬"
                      SelectionChanged="ActivityFilterBox_SelectionChanged" />
            <TextBlock x:Name="ActivityFeedbackText" Grid.Column="2" Margin="12,0"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ActivityResultText" Grid.Column="3" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
        </Border>
        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource DataSurfaceStyle}">
            <Grid>
                <ListBox x:Name="ActivityList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource ListRowStyle}"
                         AutomationProperties.Name="최근 실행 목록"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}">
                                            <Run Text="{Binding ToolName, Mode=OneWay}" /><Run Text="  ·  " />
                                            <Run Text="{Binding Risk, Mode=OneWay}" />
                                        </TextBlock>
                                        <Border Margin="8,0,0,0" Style="{StaticResource StatusBadgeStyle}">
                                            <TextBlock Style="{StaticResource StatusTagTextStyle}" Text="{Binding StatusDisplay, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="16,1,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding CreatedAtDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource EmptyStateTextStyle}"
                           Text="아직 기록된 실행이 없습니다." />
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,18,0,0" Style="{StaticResource EyebrowTextStyle}"
                   Text="되돌릴 수 있는 파일 작업" />
        <Border Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource DataSurfaceStyle}">
            <Grid>
                <ListBox x:Name="UndoList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource ListRowStyle}"
                         AutomationProperties.Name="되돌릴 수 있는 파일 작업"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Description}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}"
                                               Text="{Binding CreatedAtDisplay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{Binding UndoId}" Click="Undo_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Content="되돌리기" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyUndoMessage" Style="{StaticResource EmptyStateTextStyle}"
                           Text="되돌릴 수 있는 파일 작업이 없습니다." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
