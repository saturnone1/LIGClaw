<UserControl x:Class="LIGClaw.Desktop.FeatureBuilderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="기능 만들기 페이지">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="기능 만들기 / 검토 후 적용" />
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="새 기능 만들기" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="원하는 작업을 설명하면 안전하게 검토할 기능 초안을 준비합니다. 초안을 만드는 것만으로 기능이 켜지지는 않습니다."
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="BackButton" Grid.Column="1" Margin="16,0,0,0"
                        VerticalAlignment="Top" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Back_Click" Content="기능 목록으로 돌아가기"
                        AutomationProperties.Name="기능 목록으로 돌아가기" />
            </Grid>

            <ui:Card Margin="0,17,0,0" Padding="20">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="1. 필요한 기능 설명" />
                    <TextBlock Margin="0,5,0,12" Style="{StaticResource CaptionTextStyle}"
                               Text="작업 목적, 필요한 정보, 기대 결과와 제한을 적어 주세요. 접속 키·비밀번호·토큰 같은 비밀값은 입력하지 마세요. 비밀값 입력 칸은 제공하지 않습니다."
                               TextWrapping="Wrap" />
                    <TextBox x:Name="RequirementTextBox" MinHeight="92" MaxLength="8192"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="새 기능 요구사항" />
                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                        <Button x:Name="GenerateButton" DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Generate_Click" Content="초안 생성"
                                AutomationProperties.Name="기능 초안 생성" />
                        <TextBlock x:Name="PageStatusText" Margin="0,0,14,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextStyle}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="QuestionsSection" Margin="0,14,0,0" Padding="20"
                     Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="2. 추가 정보" />
                    <TextBlock Margin="0,5,0,12" Style="{StaticResource CaptionTextStyle}"
                               Text="아래 질문에 답하면 같은 기능 만들기 과정을 이어갑니다. 비밀값을 요구하는 질문은 표시되지 않습니다."
                               TextWrapping="Wrap" />
                    <ItemsControl x:Name="QuestionList" AutomationProperties.Name="기능 만들기 추가 질문 목록">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,13">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Prompt}" TextWrapping="Wrap" />
                                    <TextBox Margin="0,7,0,0" MaxLength="8000"
                                             Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding TextAnswerVisibility}"
                                             AutomationProperties.Name="{Binding InputAutomationName}" />
                                    <ComboBox Margin="0,7,0,0" ItemsSource="{Binding Choices}"
                                              SelectedItem="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding ChoiceAnswerVisibility}"
                                              AutomationProperties.Name="{Binding InputAutomationName}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AnswerButton" HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Answer_Click" Content="답변하고 계속"
                            AutomationProperties.Name="기능 만들기 질문 답변 제출" />
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="ProposalSection" Margin="0,14,0,0" Padding="20"
                     Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="3. 생성 제안 검토" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionTextStyle}"
                               Text="여기에는 실행 명령이나 비밀값을 표시하지 않고, 앱이 안전성을 확인한 기능 정보와 필요한 연결만 표시합니다."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ProposalNameText" Margin="0,14,0,0"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProposalIdentityText" Margin="0,4,0,0"
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProposalDependencyText" Margin="0,4,0,0"
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProposalDescriptionText" Margin="0,9,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="알려진 제한" />
                    <ItemsControl x:Name="LimitationsList" AutomationProperties.Name="생성 제안 제한 목록">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ProposalStatusText" Margin="0,13,0,0"
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Margin="0,14,0,0" HorizontalAlignment="Right">
                        <Button x:Name="RejectButton" Margin="0,0,8,8"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="Reject_Click" Content="제안 거부"
                                AutomationProperties.Name="기능 제안 거부" />
                        <Button x:Name="TestButton" Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Test_Click" Content="검사 실행"
                                AutomationProperties.Name="기능 제안 검사 실행" />
                        <Button x:Name="ApplyButton" Margin="0,0,0,8"
                                Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                                Click="Apply_Click" Content="검토 초안으로 적용"
                                AutomationProperties.Name="기능 검토 초안으로 적용" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
