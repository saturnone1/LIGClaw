<UserControl x:Class="LIGClaw.Desktop.AgentJobsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Agent 작업 관리 페이지">
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="AUTOMATION / LOCAL-FIRST" />
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Agent 작업" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="모델 요청을 예약 실행하고 결과·재시도·놓친 실행 상태를 이 PC에서 관리합니다." />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,17,0,0" Style="{StaticResource CommandBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="Create_Click" Content="새 Agent 작업" />
                <CheckBox x:Name="IncludeInactive" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="IncludeInactive_Changed" Unchecked="IncludeInactive_Changed"
                          Content="완료·취소 포함" />
                <TextBlock x:Name="PageStatusText" Grid.Column="3" Margin="12,0" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Refresh_Click" Content="새로 고침" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource DataSurfaceStyle}">
            <Grid>
                <ListBox x:Name="AgentJobList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource ListRowStyle}"
                         AutomationProperties.Name="저장된 Agent 작업 목록"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0" Text="{Binding Prompt}" TextWrapping="Wrap"
                                               MaxHeight="64" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}"
                                               Text="{Binding ScheduleText}" TextWrapping="Wrap" />
                                    <Border Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Style="{StaticResource StatusTagTextStyle}" Text="{Binding StatusText}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <Button Tag="{Binding Id}" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="History_Click" Content="실행 결과" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding CancelVisibility}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="Cancel_Click" Content="취소" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding PauseVisibility}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="Pause_Click" Content="일시정지" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding ResumeVisibility}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="Resume_Click" Content="재개" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding RetryVisibility}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="Retry_Click" Content="지금 다시 실행" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding DecisionVisibility}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="RunMissed_Click" Content="지금 실행" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}" Visibility="{Binding DecisionVisibility}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="SkipMissed_Click" Content="건너뛰기" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource EmptyStateTextStyle}"
                           Text="표시할 Agent 작업이 없습니다." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
