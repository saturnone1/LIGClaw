<UserControl x:Class="LIGClaw.Desktop.CapabilitiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="기능 관리 페이지">
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="기능 카드 / 이 PC에 안전하게 저장" />
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="기능 카드 대시보드" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="원하는 기능을 새 카드로 만들고, 필요한 연결과 안전 검사를 확인한 뒤 사용할 수 있습니다."
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="BuilderButton" Grid.Column="1" Margin="16,0,0,0"
                    VerticalAlignment="Top" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Builder_Click" Content="새 기능 만들기"
                    AutomationProperties.Name="새 기능 만들기" />
        </Grid>
        <Border Grid.Row="1" Margin="0,17,0,0" Style="{StaticResource CommandBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ImportButton" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Import_Click" Content="기능 파일 가져오기" />
                <TextBlock x:Name="PageStatusText" Grid.Column="1" Margin="12,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextStyle}"
                           AutomationProperties.LiveSetting="Polite" />
                <ComboBox x:Name="CapabilityFilterBox" Grid.Column="2" MinWidth="124"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectionChanged="CapabilityFilterBox_SelectionChanged"
                          AutomationProperties.Name="기능 상태 필터" />
                <ComboBox x:Name="CapabilitySortBox" Grid.Column="3" MinWidth="132" Margin="8,0,0,0"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectionChanged="CapabilitySortBox_SelectionChanged"
                          AutomationProperties.Name="기능 정렬" />
                <Button x:Name="RefreshButton" Grid.Column="4" Margin="8,0,0,0"
                        Style="{StaticResource CompactButtonStyle}"
                        Click="Refresh_Click" Content="새로 고침" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource DataSurfaceStyle}"
                AutomationProperties.Name="기능 카드 대시보드">
            <Grid>
                <ListBox x:Name="CapabilityList" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="설치된 기능 목록"
                         AutomationProperties.HelpText="만든 기능과 가져온 기능을 카드로 관리합니다."
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRowStyle}">
                            <Setter Property="Width" Value="340" />
                            <Setter Property="MinHeight" Value="270" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="18" Margin="1"
                                     AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                                   Text="{Binding DisplayName, Mode=OneWay}" />
                                        <ui:Badge Grid.Column="1" Margin="10,0,0,0"
                                                  VerticalAlignment="Top" Appearance="Secondary">
                                            <TextBlock Style="{StaticResource StatusTagTextStyle}"
                                                       Text="{Binding StatusText, Mode=OneWay}" />
                                        </ui:Badge>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Text="{Binding IdentityText, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                                                   Text="{Binding VersionText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,12,0,12">
                                        <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                   TextWrapping="Wrap" MaxHeight="66"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,9,0,0" Style="{StaticResource CaptionTextStyle}"
                                                   Text="{Binding MetadataText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                                        <Button Margin="0,0,7,7" Tag="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="Review_Click" Content="검토" />
                                        <Button Margin="0,0,7,7" Tag="{Binding}"
                                                Visibility="{Binding ExportVisibility, Mode=OneWay}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="Export_Click" Content="내보내기" />
                                        <Button Margin="0,0,0,7" Tag="{Binding}"
                                                Visibility="{Binding RollbackVisibility, Mode=OneWay}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="RollbackReview_Click" Content="이전 버전 검토" />
                                    </WrapPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource EmptyStateTextStyle}"
                           Text="아직 기능 카드가 없습니다. ‘새 기능 만들기’에서 원하는 일을 설명해 보세요." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
