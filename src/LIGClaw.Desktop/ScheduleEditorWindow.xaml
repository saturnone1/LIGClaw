<Window x:Class="LIGClaw.Desktop.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="예약 수정 · LIGClaw" Height="620" Width="610"
        MinHeight="560" MinWidth="520" Icon="Assets/ligclaw.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SCHEDULE / LOCAL TIME" />
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="예약 수정" />
                <TextBlock Margin="0,18,0,5" Text="제목" />
                <TextBox x:Name="TitleBox" MaxLength="63" AutomationProperties.Name="예약 제목" />
                <TextBlock Margin="0,14,0,5" Text="알림 내용" />
                <TextBox x:Name="MessageBox" MaxLength="255" MinHeight="70"
                         AutomationProperties.Name="알림 내용"
                         AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBlock Margin="0,14,0,5" Text="시작 현지 시각 (yyyy-MM-ddTHH:mm:ss)" />
                <TextBox x:Name="StartLocalBox" AutomationProperties.Name="첫 실행 시각" />
                <TextBlock Margin="0,14,0,5" Text="시간대 ID" />
                <TextBox x:Name="TimeZoneBox" MaxLength="128" AutomationProperties.Name="시간대" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" Text="반복" />
                        <ComboBox x:Name="RecurrenceBox" AutomationProperties.Name="반복 주기">
                            <ComboBoxItem Tag="once" Content="한 번" />
                            <ComboBoxItem Tag="daily" Content="매일" />
                            <ComboBoxItem Tag="weekly" Content="매주" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,5" Text="반복 간격" />
                        <TextBox x:Name="IntervalBox" AutomationProperties.Name="반복 간격" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,14,0,5" Text="앱이 꺼져 있어 실행을 놓친 경우" />
                <ComboBox x:Name="MisfireBox" AutomationProperties.Name="놓친 실행 처리">
                    <ComboBoxItem Tag="skip" Content="건너뛰고 다음 회차 유지" />
                    <ComboBoxItem Tag="run_once_on_resume" Content="앱 재시작 시 한 번 실행" />
                    <ComboBoxItem Tag="ask" Content="예약 관리에서 확인" />
                </ComboBox>
                <TextBlock x:Name="ValidationMessage" Margin="0,13,0,0"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="92" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Content="취소" />
            <Button Width="92" Margin="9,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" Content="저장" />
        </StackPanel>
    </Grid>
</Window>
