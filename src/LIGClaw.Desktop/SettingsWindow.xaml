<Window x:Class="LIGClaw.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIGClaw 설정" Width="560" Height="650"
        MinWidth="560" MinHeight="650" ResizeMode="NoResize"
        Icon="Assets/ligclaw.ico" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="25" FontWeight="SemiBold" Text="설정" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="자주 사용하는 실행 방식을 정할 수 있어요." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Windows 시작 시 자동 실행" />
                    <TextBlock Margin="0,5,18,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="로그인하면 창을 띄우지 않고 트레이에서 준비합니다."
                               TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1"
                          AutomationProperties.Name="Windows 시작 시 LIGClaw 자동 실행"
                          Style="{StaticResource ToggleSwitchStyle}"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="모델 API 연결" />
                <TextBlock Margin="0,4,0,13" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="OpenAI 호환 API의 연결 정보를 입력하세요." />
                <TextBlock FontSize="12" Text="Base URL" />
                <TextBox x:Name="BaseUrlTextBox" Margin="0,5,0,10" />
                <TextBlock FontSize="12" Text="Model" />
                <TextBox x:Name="ModelTextBox" Margin="0,5,0,10" />
                <TextBlock FontSize="12" Text="API Key" />
                <PasswordBox x:Name="ApiKeyPasswordBox" Margin="0,5,0,0" Padding="12,10"
                             AutomationProperties.Name="API Key" />
                <TextBlock x:Name="SavedKeyHint" Margin="0,5,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="비워 두면 저장된 키를 그대로 사용합니다." />
                <Button Margin="0,13,0,0" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="TestConnection_Click" Content="연결 테스트" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="18,15" CornerRadius="10"
                Background="{DynamicResource BrandIceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="빠른 호출" />
                    <TextBlock x:Name="ShortcutStatusText" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="어느 화면에서든 LIGClaw를 바로 열 수 있어요." />
                </StackPanel>
                <Border Grid.Column="1" Padding="12,7" CornerRadius="6"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold"
                               Text="Ctrl + Alt + Space" />
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="SettingsStatusText" Grid.Row="4" Margin="0,13,0,0"
                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,9,0" Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click" Content="취소" />
            <Button Click="Save_Click" Content="저장" />
        </StackPanel>
    </Grid>
</Window>
