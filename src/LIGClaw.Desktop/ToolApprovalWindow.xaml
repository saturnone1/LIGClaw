<ui:FluentWindow x:Class="LIGClaw.Desktop.ToolApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="동작 승인" Width="740" Height="500"
        MinWidth="600" MinHeight="400" MaxWidth="760" MaxHeight="500"
        Icon="Assets/ligclaw.ico"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Height="32" Title="동작 승인" />
        <Grid Grid.Row="1" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="실행 승인 / 사용자 확인" />
            <TextBlock x:Name="HeadingText" Margin="0,7,0,0" Style="{StaticResource PageTitleStyle}"
                       Text="이 동작을 허용할까요?" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer x:Name="DetailsScrollViewer" Grid.Row="1" Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="True" IsTabStop="True" PanningMode="VerticalOnly"
                      AutomationProperties.Name="승인할 동작 전체 미리보기"
                      AutomationProperties.HelpText="Tab 키로 이 영역에 이동한 뒤 방향키, Page Up, Page Down, Home, End 키로 전체 내용을 확인할 수 있습니다.">
            <Border Style="{StaticResource CardStyle}"
                    Background="{DynamicResource BrandIceBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="실행할 작업" />
                    <TextBlock x:Name="ActionText" Margin="0,6,0,0" Style="{StaticResource ActionTitleStyle}"
                               AutomationProperties.Name="승인할 동작" TextWrapping="Wrap" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Badge Appearance="Caution">
                            <TextBlock x:Name="RiskText" Style="{StaticResource StatusTagTextStyle}" FontWeight="SemiBold" />
                        </ui:Badge>
                        <ui:Badge Margin="7,0,0,0" Appearance="Secondary">
                            <TextBlock x:Name="UndoText" Style="{StaticResource StatusTagTextStyle}" />
                        </ui:Badge>
                    </StackPanel>
                    <TextBlock Margin="0,14,0,0" Style="{StaticResource EyebrowTextStyle}"
                               Text="자세한 내용 / 전체 미리 보기" />
                    <TextBlock x:Name="DetailsText" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.AutomationId="ApprovalDetailsText"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <ui:InfoBar x:Name="ScopeInfoBar" Grid.Row="2" Margin="0,16,0,0"
                    IsOpen="True" IsClosable="False" Severity="Warning"
                    Title="허용 범위와 기간"
                    Message="허용하면 이번 요청에서 이 동작을 한 번만 실행합니다." />

        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DenyButton" Grid.Column="1" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}" IsDefault="True"
                    IsCancel="True" Click="Deny_Click" Content="허용 안 함" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                    Click="AllowOnce_Click" Content="이번 한 번 허용" />
            <Button x:Name="AllowConversationButton" Grid.Column="3" Margin="10,0,0,0"
                    Click="AllowConversation_Click" Content="이 대화 동안 허용"
                    AutomationProperties.Name="표시된 동작을 이 대화 동안 허용" />
            <Button x:Name="AllowAlwaysButton" Grid.Column="4" Margin="10,0,0,0"
                    Click="AllowAlways_Click" Content="30일 동안 항상 허용"
                    AutomationProperties.Name="이 동작을 30일 동안 항상 허용" />
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
