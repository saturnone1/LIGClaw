<UserControl x:Class="LIGClaw.Desktop.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="기억 관리 페이지">
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="MEMORY / LOCAL CONTEXT" />
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="기억 관리" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="LIGClaw가 이 PC에 저장한 기억을 확인하고 추가·수정·삭제할 수 있습니다." />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PageStatusText" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"
                    Click="Export_Click" Content="JSON 내보내기" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Add_Click" Content="기억 추가" />
        </Grid>
        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource CommandBarStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="38" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" AutomationProperties.Name="기억 검색" />
            <Button x:Name="ClearSearchButton" Grid.Column="1" Margin="8,0,0,0"
                    Style="{StaticResource CompactButtonStyle}" Visibility="Collapsed"
                    Click="ClearSearch_Click" Content="검색 지우기" />
            <ComboBox x:Name="MemorySortBox" Grid.Column="2" MinWidth="120" Margin="8,0,0,0"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectionChanged="MemorySortBox_SelectionChanged"
                      AutomationProperties.Name="기억 정렬" />
        </Grid>
        </Border>
        <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource DataSurfaceStyle}">
            <Grid>
                <ListBox x:Name="MemoryList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource ListRowStyle}"
                         AutomationProperties.Name="저장된 기억 목록"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Key}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0" Text="{Binding Value}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionTextStyle}"
                                               Text="{Binding Metadata}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                                    <Button Tag="{Binding Id}" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="Edit_Click" Content="수정" />
                                    <Button Margin="0,7,0,0" Tag="{Binding Id}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="Delete_Click" Content="삭제" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource EmptyStateTextStyle}"
                           Text="저장된 기억이 없습니다." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
